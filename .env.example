# Development deployment example. Copy to this project's root .env (permissions 0600; ignored by Git).
# The address/namespace/profile below follow the existing MOM development environment; adjust them per environment.
# Leave secrets out of Git, CI output, image layers and tickets.
MOM_NACOS_SERVER_ADDR=service.example.invalid
# Actual namespace ID, not the display name.
MOM_NACOS_NAMESPACE=kitex-mom-pg
MOM_NACOS_GROUP=DEFAULT_GROUP
# Loads application-dev.yml and <spring.application.name>-dev.yml from Nacos.
MOM_CONFIG_PROFILE=dev
# Fill these two values only in .env or a deployment Secret; blanks deliberately block startup.
MOM_NACOS_USERNAME=
MOM_NACOS_PASSWORD=
# WMS XXL-JOB executor port; use a distinct port when services share a host.
MOM_WMS_XXL_JOB_EXECUTOR_PORT=9101

# Sentinel has its own least-privilege account; do not reuse the service account.
MOM_SENTINEL_NACOS_PASSWORD=
MOM_SENTINEL_PASSWORD=
# Optional: defaults to the same Nacos address/namespace used above.
# MOM_SENTINEL_NACOS_SERVER_ADDR=
# MOM_SENTINEL_NACOS_NAMESPACE=
MOM_SENTINEL_NACOS_USERNAME=
MOM_SENTINEL_USERNAME=
