<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kitex.mom.iot.mapper.IotSceneHistoryMapper">

    <resultMap id="historyMap" type="com.kitex.mom.iot.entity.IotSceneHistoryEntity">
        <id property="id" column="id"/>
        <result property="sceneId" column="scene_id"/>
        <result property="sceneName" column="scene_name"/>
        <result property="triggerType" column="trigger_type"/>
        <result property="status" column="status"/>
        <result property="result" column="result"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <select id="selectHistoryPage" resultMap="historyMap">
        SELECT * FROM iot_scene_history
        <where>
            del_flag = '0'
            <if test="query.sceneId != null">
                AND scene_id = #{query.sceneId}
            </if>
            <if test="query.sceneName != null and query.sceneName != ''">
                AND scene_name LIKE CONCAT('%', #{query.sceneName}, '%')
            </if>
            <if test="query.triggerType != null and query.triggerType != ''">
                AND trigger_type = #{query.triggerType}
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper> 