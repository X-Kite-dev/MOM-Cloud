<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kitex.mom.iot.mapper.IotSceneMapper">

    <resultMap id="sceneMap" type="com.kitex.mom.iot.entity.IotSceneEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="triggerType" column="trigger_type"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="triggerConfig" column="trigger_config"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="actions" column="actions"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <select id="selectScenePage" resultMap="sceneMap">
        SELECT * FROM iot_scene
        <where>
            del_flag = '0'
            <if test="query.name != null and query.name != ''">
                AND name LIKE CONCAT('%', #{query.name}, '%')
            </if>
            <if test="query.triggerType != null and query.triggerType != ''">
                AND trigger_type = #{query.triggerType}
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper> 