<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kitex</groupId>
        <artifactId>mom</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>
    <packaging>pom</packaging>
    <artifactId>mom-cloud</artifactId>

    <modules>
        <module>mom-mdm</module>
        <module>mom-mes</module>
        <module>mom-plan</module>
        <module>mom-pms</module>
        <module>mom-wms</module>
        <module>mom-tpm</module>
        <module>mom-qms</module>
        <module>mom-common</module>
        <module>mom-iot</module>
        <!-- 仅聚合构建；AI仍使用独立Boot 4父POM，统一Maven构建需JDK 21。 -->
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <distributionManagement>
        <repository>
            <id>kitex-releases</id>
            <url>http://mvn.tepusoft.cn/repository/kitex-releases/</url>
        </repository>
        <snapshotRepository>
            <id>kitex-snapshots</id>
            <url>http://mvn.tepusoft.cn/repository/kitex-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <profile>
            <id>cloud</id>
            <properties>
                <!-- 环境标识，需要与配置文件的名称相对应 -->
                <profiles.active>dev</profiles.active>
            </properties>
            <activation>
                <!-- 默认环境 -->
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
    </profiles>


</project>
